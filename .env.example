# Banco PostgreSQL compartilhado
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/commanddesk?sslmode=require

# URL pública do app (sem / final)
APP_URL=http://localhost:3000

# Comece com true para validar a aplicação sem Microsoft 365.
# Em produção, altere para false.
PILOT_DEMO_MODE=true

# Sessão
# Gere uma string longa e aleatória (mínimo recomendado: 32 bytes).
SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Microsoft Entra / Microsoft 365
# Necessários quando PILOT_DEMO_MODE=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use "organizations" para contas corporativas ou o tenant ID específico.
MICROSOFT_TENANT_ID=organizations

# Chave Base64 de 32 bytes para criptografar refresh tokens no banco.
# Exemplo de geração:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
